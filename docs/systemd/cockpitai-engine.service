[Unit]
Description=CockpitAI AI Engine - Agent Dispatcher
After=network.target
Documentation=https://github.com/MrLouix/cockpitAI

[Service]
Type=simple
WorkingDirectory=/home/ai_agent/projects/cockpitAI/engine
ExecStart=/usr/bin/node --no-warnings runEngine.js
Restart=on-failure
RestartSec=5
Environment=MONGODB_URI=mongodb://100.71.107.100:27017/cockpitai
Environment=POLL_INTERVAL=5000
Environment=DEFAULT_TIMEOUT=300000
Environment=ENGINE_PORT=3332
Environment=NODE_ENV=production
StandardOutput=append:/home/ai_agent/projects/cockpitAI/logs/engine.log
StandardError=append:/home/ai_agent/projects/cockpitAI/logs/engine-error.log

[Install]
WantedBy=default.target
